DATABASE_URL=postgresql://USUARIO:CONTRASENA@SERVIDOR/neondb?sslmode=require
SECRET_KEY=reemplaza-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# En desarrollo se muestran los correos en la consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexo Talento <no-reply@example.com>

# Directorio no público para currículos PDF durante desarrollo.
PRIVATE_UPLOAD_ROOT=private_uploads

# Almacenamiento privado de currículos en Backblaze B2.
# Actívalo solo cuando las cinco variables de conexión estén configuradas.
BACKBLAZE_ENABLED=False
BACKBLAZE_APPLICATION_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=sistema-cv-curriculos-privados
BACKBLAZE_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
BACKBLAZE_OBJECT_PREFIX=curriculos
BACKBLAZE_PRESIGNED_URL_EXPIRY=300

# Analisis inteligente de curriculos con Groq.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_TOKENS=2500
ANALYSIS_MAX_TEXT_CHARS=16000

# OCR opcional para PDFs escaneados. Requiere Tesseract instalado en el servidor.
ANALYSIS_OCR_ENABLED=True
ANALYSIS_OCR_MAX_PAGES=5
ANALYSIS_OCR_DPI=150
TESSERACT_CMD=
TESSERACT_LANG=spa+eng

# Procesamiento asíncrono de análisis con Celery y Redis.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ANALYSIS_ASYNC_ENABLED=False
ANALYSIS_TASK_MAX_RETRIES=3
ANALYSIS_TASK_LEASE_SECONDS=900
