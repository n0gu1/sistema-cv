DATABASE_URL=postgresql://USUARIO:CONTRASENA@SERVIDOR/neondb?sslmode=require
SECRET_KEY=reemplaza-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# En desarrollo se muestran los correos en la consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexo Talento <no-reply@example.com>

# Directorio no público para currículos PDF durante desarrollo.
PRIVATE_UPLOAD_ROOT=private_uploads

# Almacenamiento privado de currículos en Backblaze B2.
# Actívalo solo cuando las cinco variables de conexión estén configuradas.
BACKBLAZE_ENABLED=False
BACKBLAZE_APPLICATION_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=sistema-cv-curriculos-privados
BACKBLAZE_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
BACKBLAZE_OBJECT_PREFIX=curriculos
BACKBLAZE_PRESIGNED_URL_EXPIRY=300
